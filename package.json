{
  "name": "atto1",
  "private": true,
  "version": "1.3.1",
  "packageManager": "pnpm@12.13.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "check": "bash scripts/check.sh",
    "lint": "oxlint --type-aware .",
    "test": "vitest run",
    "db:migrate": "bash scripts/require-deploy-checkout.sh && node scripts/render-wrangler.ts && wrangler d1 migrations apply atto1 --remote --config wrangler.deploy.jsonc",
    "deploy": "bash scripts/require-deploy-checkout.sh && pnpm run build && node scripts/render-wrangler.ts && wrangler deploy --config wrangler.deploy.jsonc",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.39.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@semantic-release/github": "^11.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "happy-dom": "^21.0.3",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2004",
    "semantic-release": "^24.2.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.3"
  }
}
