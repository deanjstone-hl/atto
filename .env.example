# Copy to .env (gitignored) only for a break-glass deploy or a manual collector run; load it with
#   set -a; . ./.env; set +a
# Every private value lives in Bitwarden Secrets Manager (BWS), as ATTO_* keys (atto1/104, atto1/108;
# the <REPO>_<KEY> layout of argus-config/1414), and in the Actions secrets of the same name, which
# the deploy workflow hands to wrangler as environment variables. A variable below overrides the
# BWS secret of the same name; for a break-glass deploy by hand, leave it blank to read BWS with
# your own BWS_ACCESS_TOKEN (an access token with read access to the project that holds the keys).
BWS_ACCESS_TOKEN=

# Worker settings, rendered into wrangler.deploy.jsonc by scripts/render-wrangler.ts.
# The D1 database id (`wrangler d1 create atto1` prints it)
ATTO_D1_DATABASE_ID=
# <team>.cloudflareaccess.com
ATTO_ACCESS_TEAM_DOMAIN=
# The Access application's Audience (AUD) tag
ATTO_ACCESS_AUD=
# The atto1-ingest service token's Client ID (the collector reads it too)
ATTO_INGEST_CLIENT_ID=
# The owner's Access subject, from /api/me when signed in
ATTO_INGEST_OWNER_SUBJECT=
# The atto1-carplay-phone service token's Client ID (the phone's Shortcut holds the token; atto/6)
ATTO_TRIGGER_CLIENT_ID=

# Cloudflare credentials for wrangler. In CI these are the CLOUDFLARE_API_TOKEN and
# CLOUDFLARE_ACCOUNT_ID Actions secrets; by hand, read them into the shell (the token is
# ci-deploy-atto1 in BWS), never into this file.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# The BYD collector (collector/run.ts), read from BWS by name when blank:
# the BWS secrets named atto1-byd-* and atto1-ingest-client-* (see docs/byd-collector.md)
BYD_USERNAME=
BYD_PASSWORD=
CF_ACCESS_CLIENT_ID=
ATTO1_BATTERY_KWH=
CF_ACCESS_CLIENT_SECRET=
